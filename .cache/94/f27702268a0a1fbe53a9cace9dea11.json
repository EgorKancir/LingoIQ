h: 150px;\n    height: 150px;\n    border-radius: 50%;\n    object-fit: cover;\n    object-position: center;\n}\n.language-name {\n    font-family: 'Squada One', sans-serif;\n    font-weight: 400; \n    font-size: 100px;\n    letter-spacing: 0px;\n    line-height: normal; \n    text-align: center;\n}\n\n/* |----------------------------------------PROGRESS--------------------------------------------| */\n\n.progress {\n    width: 520px;\n    padding: 20px 40px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    flex-direction: column;\n    gap: 20px;\n    background: linear-gradient(rgba(0, 1, 5, 0.4) 0%, rgba(0, 18, 196, 1) 60%, rgba(48, 177, 236, 1) 100%);\n    border-radius: 50px;\n}\n.progress__title {\n    font-family: 'Inter', sans-serif;\n    font-style: italic; \n    font-weight: 900; \n    font-size: 45px;\n    line-height: normal; \n    letter-spacing: 0px;\n    text-align: center;\n}\n.progress__info-group {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 20px;\n}\n.progress__days {\n    font-family: 'Inter', sans-serif;\n    font-weight: 700; \n    font-size: 18px;\n    letter-spacing: 0px;\n    line-height: normal;\n    text-align: left;\n}\n.progress__days-number {\n    font-family: 'Inter', sans-serif;\n    font-weight: 300; \n    font-size: 18px;\n    letter-spacing: 0px;\n    line-height: normal;\n    text-align: left;\n}\n.progress__words {\n    font-family: 'Inter', sans-serif;\n    font-weight: 700; \n    font-size: 18px;\n    letter-spacing: 0px;\n    line-height: normal;\n    text-align: left;\n}\n.progress__words-number {\n    font-family: 'Inter', sans-serif;\n    font-weight: 300; \n    font-size: 18px;\n    letter-spacing: 0px;\n    line-height: normal;\n    text-align: left;\n}\n.progress__graph {\n    background: rgba(255, 255, 255, 0.3);\n    display: flex;\n    justify-content: start;\n    align-items: center;\n    width: 512px;\n    height: 42px;\n    padding: 3px;\n    border-radius: 20px;\n}\n.progress__graph-block {\n    background: rgba(0, 60, 255, 1);\n    border: 1px solid rgb(255 255 255 / 5%);\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    width: 50%;\n    height: 42px;\n    border-radius: 20px;\n}\n.progress__graph-percent {\n    font-family: 'Inter', sans-serif;\n    font-weight: 700; \n    font-size: 20px;\n    letter-spacing: 0px;\n    line-height: normal; \n    opacity: 1; \n    color: black;\n}\n\n/* |----------------------------------------WEB-NAVIAGTION-------------------------------------------| */\n\n.web-navigation {\n    padding: 30px 0;\n    width: 100%;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    flex-direction: column;\n    gap: 20px;\n    background: linear-gradient(rgba(0, 1, 5, 0.4) 0%, rgba(0, 18, 196, 1) 60%, rgba(48, 177, 236, 1) 100%);\n    border-radius: 50px;\n}\n.web-navigation__title {\n    font-family: 'Inter', sans-serif;\n    font-style: italic; \n    font-weight: 900; \n    font-size: 45px;\n    line-height: normal; \n    letter-spacing: 0px;\n    text-align: center;\n}\n.web-navigation__pages-list {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 62px;\n}\n.web-navigation__page-link {\n    width: 240px;\n    height: 240px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    flex-direction: column;\n    gap: 10px;\n    border-radius: 20px;\n    background: linear-gradient(135deg, #7E8AF4 22%, #0012C4 85%);\n}\n.web-navigation__page-icon {\n    width: 100px;\n    height: 100px;\n}\n.web-navigation__page-name {\n    width: 200px;\n    height: 65px;\n    font-family: 'Inter', sans-serif;\n    font-weight: 900; \n    font-size: 30px;\n    letter-spacing: 0px;\n    line-height: normal; \n    text-align: center;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n}\n.web-navigation__page-link:hover {\n    transform: scale(1.04);\n}"},"line