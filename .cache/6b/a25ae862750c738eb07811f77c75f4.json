opyrighting {\n    font-family: 'Inter', sans-serif;\n    font-style: normal;\n    font-weight: 300; \n    font-size: 14px;\n    line-height: normal;\n    letter-spacing: 0px;\n    text-align: center;\n}\n.footer__rules-list {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 20px;\n}\n.footer__rules-item {\n    font-family: 'Inter', sans-serif;\n    font-style: normal;\n    font-weight: 300; \n    font-size: 14px;\n    line-height: normal;\n    letter-spacing: 0px;\n    text-align: center;\n}\n.footer__rules-item:hover {\n    display: block;\n    transform: scale(1.02);\n    opacity: 0.7;\n}"},"lineCount":null}},"error":null,"hash":"0200ad3e24236cbe4fd6601c52878c7d","cacheData":{"env":{}}}