ne;\n    background-color: inherit;\n    background: inherit;\n    padding: 0;\n    margin: 0;\n    outline: none;\n}\n.disable {\n    display: none !important;\n}\n/* ----------------------------------------MAIN--------------------------------------------| */\n\n.main__content {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    flex-direction: column;\n    gap: 70px;\n}\n/* ----------------------------------------QUOTE--------------------------------------------| */\n\n.quote {\n    width: 75%;\n    font-family: \"Audiowide\", sans-serif;\n    font-style: normal;\n    font-weight: 400;\n    font-size: 75px;\n    line-height: normal; \n    letter-spacing: 0px;\n    text-align: center;\n}\n\n/* ----------------------------------------FOOTER--------------------------------------------| */\n\n.footer {\n    width: 1158px;\n    background: rgba(0, 0, 0, 0.2);\n    padding: 20px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    flex-direction: column;\n    gap: 60px;\n    border: rgba(255, 255, 255, 0.05) 1px solid;\n    border-radius: 50px;\n    margin: 50px auto 0;\n}\n.footer-panel__logo-img {\n    width: 209px;\n    height: 55px;\n}\n.footer__social-media {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 10px;\n}\n.footer__social-media-icon {\n    width: 32px;\n    height: 32px;\n}\n.footer__social-media-icon:hover {\n    display: block;\n    transform: scale(1.02);\n    opacity: 0.7;\n}\n.footer__politics-group {\n    width: 100%;\n    border-top: white 2px solid;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding-top: 20px;\n}\n.footer__copyrighting {\n    font-family: 'Inter', sans-serif;\n    font-style: normal;\n    font-weight: 300; \n    font-size: 14px;\n    line-height: normal;\n    letter-spacing: 0px;\n    text-align: center;\n}\n.footer__rules-list {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 20px;\n}\n.footer__rules-item {\n    font-family: 'Inter', sans-serif;\n    font-style: normal;\n    font-weight: 300; \n    font-size: 14px;\n    line-height: normal;\n    letter-spacing: 0px;\n    text-align: center;\n}\n.footer__rules-item:hover {\n    display: block;\n    transform: scale(1.02);\n    opacity: 0.7;\n}"},"lineCount":null}},"error":null,"hash":"2a16a7734ae61c6a19f0ddf3c2cacb54","cacheData":{"env":{}}}