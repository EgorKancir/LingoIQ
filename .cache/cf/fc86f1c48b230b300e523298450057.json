,{"source":"glossary.css","name":null,"original":{"line":230,"column":16},"generated":{"line":1,"column":3637}},{"source":"glossary.css","name":null,"original":{"line":231,"column":4},"generated":{"line":1,"column":3638}},{"source":"glossary.css","name":null,"original":{"line":232,"column":0},"generated":{"line":1,"column":3658}}],"sources":{"glossary.css":".glossary__icon {\n    width: 150px;\n    height: 150px;\n}\n.glossary__title {\n    font-family: 'Squada One', sans-serif;\n    font-weight: 400; \n    font-size: 100px;\n    letter-spacing: 0px;\n    line-height: normal; \n    text-align: center;\n}\n.glossary-table {\n    width: 100%;\n    background: linear-gradient(0deg, rgba(0, 1, 5, 0.65) 0%, rgba(0, 18, 196, 1) 33%, rgba(48, 177, 236, 1) 100%);\n    border-radius: 20px;\n    overflow: hidden;\n    color: #ffffff;\n    border-collapse: collapse;\n}\n.glossary-table__header-tr {\n    height: 60px;\n    background: rgb(82 142 227);\n}\n.glossary-table__header-th {\n    font-family: 'Inter', sans-serif;\n    font-weight: 700;\n    font-size: 18px;\n    letter-spacing: 0px;\n    line-height: normal; \n    text-align: left;\n    padding-left: 20px;\n    /* width: 240px; */\n}\n.glossary-table__header-th--number {\n    width: 60px;\n    padding: 0;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n}\n.glossary-table__icon-setting {\n    width: 20px;\n    height: 20px;\n}\n.glossary-table__header-th-center {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    height: 60px;\n}\n.glossary-table__body {\n    background: rgba(255, 255, 255, 0.05);\n}\n.glossary-table__footer-tr {\n    height: 64px;\n}\n.glossary-table__footer-td {\n    text-align: center;\n    vertical-align: middle;\n}\n.glossary-table__add-btn:hover {\n    transform: scale(1.03);\n    opacity: 0.7;\n}\n.glossary-table__icon-plus {\n    width: 40px;\n    height: 40px;\n}\n.glossary-table__body-tr {\n    transition: background-color 0.2s ease;\n    text-align: center;\n}\n.glossary-table__body-tr:hover {\n    background-color: rgba(255, 255, 255, 0.05);\n}\n.glossary-table__body-td {\n    font-family: 'Inter', sans-serif;\n    font-weight: 400; \n    font-size: 14px;\n    letter-spacing: 0px;\n    line-height: normal; \n    text-align: left;\n    width: 240px;\n    height: 52px;\n    padding-left: 20px;\n}\n.glossary-table__body-td--number {\n    font-family: 'Inter', sans-serif;\n    font-weight: 800;\n    font-size: 18px;\n    letter-spacing: 0px;\n    line-height: normal; \n    text-align: center;\n    background: rgb(82 142 227);\n    width: 60px;\n    padding: 0;\n}\n.glossary-table__status--studied {\n    color: rgba(106, 255, 220, 1); \n}\n.glossary-table__status--study {\n    color: rgba(255, 237, 0, 1); \n}\n.glossary-table__status--not-studied {\n    color: rgba(255, 132, 132, 1); \n}\n.glossary-table__body-td-center {\n    text-align: center;\n    padding: 0;\n}\n.glossary-table__body-btn-group {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 20px;\n}\n.icon-pen {\n    width: 20px;\n    height: 20px;\n}\n.glossary-table__icon-basket {\n    width: 25px;\n    height: 25px;\n}\n.glossary-table__body-btn--edit,\n.glossary-table__body-btn--delete {\n    background: transparent;\n    border: none;\n    cursor: pointer;\n    transition: transform 0.15s ease, opacity 0.15s ease;\n}\n.glossary-table__body-btn--edit:hover,\n.glossary-table__body-btn--delete:hover {\n    opacity: 0.5;\n    transform: scale(1.15);\n}\n\n/* |----------------------------------------FORM--------------------------------------------| */\n\n.glossary-form__tr {\n    height: 52px;\n}\n.glossary-form__number{\n    font-family: 'Inter', sans-serif;\n    font-weight: 800;\n    font-size: 18px;\n    letter-spacing: 0px;\n    line-height: normal; \n    text-align: center;\n    background: rgb(82 142 227);\n    width: 60px;\n    padding: 0;\n}\n.glossary-form__input {\n    width: 160px;\n    height: 27px;\n    background: rgba(255, 255, 255, 0.3);\n    border-radius: 20px;\n    padding: 0 15px;\n    font-family: 'Inter', sans-serif;\n    font-weight: 100; \n    font-size: 14px;\n    letter-spacing: 0px;\n    line-height: normal; \n    text-align: left;\n    color: white;\n}\n.glossary-form__input::placeholder {\n    color: white;\n}\n.glossary-form__select {\n    width: 158px;\n    height: 25px;\n    background: rgba(255, 255, 255, 0.3);\n    border-radius: 20px;\n    padding: 0 15px;\n    border: none;\n    font-family: 'Inter', sans-serif;\n    font-weight: 100; \n    font-size: 14px;\n    letter-spacing: 0px;\n    line-height: normal; \n    text-align: left;\n    color: white;\n    appearance: none; \n    background-image: url(\"../img/glossary/select-arrow.svg\");\n    background-repeat: no-repeat;\n    background-size: 18px 18px;\n    background-position: top 50% right 15px;\n    cursor: pointer;\n    border: 1px rgba(255, 255, 255, 0.3) solid;\n}\n.glossary-form__select:hover {\n    border: 1px white solid;\n}\n.glossary-form__option {\n}\n.glossary-select__option--studied {\n}\n.glossary-select__option--study {\n}\n.glossary-select__option--not-studied {\n}\n.glossary-table__body-td-center {\n}\n.glossary-form__form {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 20px;\n}\n.glossary-form__btn-submit:hover {\n    opacity: 0.7;\n    transform: scale(1.1);\n}\n.glossary-form__btn-icon {\n    width: 25px;\n    height: 25px;\n}\n.glossary-form__btn-cencel {\n    font-family: 'Inter', sans-serif;\n    font-weight: 400; \n    font-size: 14px;\n    letter-spacing: 0px;\n    line-height: normal;\n    text-align: left;\n}\n.glossary-form__btn-cencel:hover {\n    opacity: 0.7;\n    transform: scale(1.1);\n}\n"},"lineCount":null}},"error":null,"hash":"497268920bb8a228a27c6daf36a20fe7","cacheData":{"env":{}}}