anguage-button\">\n                    <img src=\"/c882a9b512f21348bd8f53966ce7e1b2.svg\" alt=\"Language-button\">\n                </button>\n                <!-- POPUP -->\n                <div class=\"header-language-popup disable\">\n                    <ul class=\"header-language-popup__list\">\n                        <li class=\"header-language-popup__item\">\n                            <button class=\"header-language-popup__button header-language-popup__button--active\" type=\"button\" id=\"English\">English</button>\n                        </li>\n                        <li class=\"header-language-popup__item\">\n                            <button class=\"header-language-popup__button\" type=\"button\" id=\"German\">German</button>\n                        </li>\n                        <li class=\"header-language-popup__item\">\n                            <button class=\"header-language-popup__button\" type=\"button\" id=\"Ukrainian\">Ukrainian</button>\n                        </li>\n                    </ul>\n                </div>\n                <!-- POPUP -->\n            </div>\n            <div class=\"header__registration-block\">\n                <button type=\"button\" class=\"header__registration-signin\">Sign in</button>\n                <button type=\"button\" class=\"header__registration-start\">\n                    Start Learning\n                    <img src=\"/9632b13b2c2758c19e95abb9160096d0.svg\" alt=\"icon\" class=\"header__registration-start-icon\">\n                </button>\n            </div>\n        </div>\n        <!-- POPUP -->\n        <div class=\"header-registration-singup-popup\">\n            <div class=\"header-registration-popup__img-block\">\n                <img class=\"header-registration-popup__img\" src=\"/bf6a3346bdc9b54b550f984ab3087c7a.jpg\" alt=\"Mascot\">\n            </div>\n            <div class=\"header-registration-popup__info-section\">\n                <div class=\"header-registration-popup__text-group\">\n                    <h1 class=\"header-registration-popup__title\">Hello!</h1>\n                    <h2 class=\"header-registration-popup__subtitle\">Craete your Account</h2>\n                </div>\n                <form class=\"header-registration-popup__form\">\n                    <label class=\"header-registration-popup__label\" for=\"username-singup\">\n                        <input class=\"header-registration-popup__input\" type=\"text\" id=\"username-singup\" placeholder=\"Username\">\n                    </label>\n                    <label class=\"header-registration-popup__label\" for=\"email-singup\">\n                        <input class=\"header-registration-popup__input\" type=\"email\" id=\"email-singup\" placeholder=\"Email\">\n                    </label>\n                    <label class=\"header-registration-popup__label\" for=\"password-singup\">\n                        <input class=\"header-registration-popup__input\" type=\"password\" id=\"password-singup\" placeholder=\"Password\">\n                    </label>\n                    <button class=\"header-registration-popup__submit\" id=\"submit-singup\" type=\"submit\">Sing Up</button>\n                    <p class=\"header-registration-signup-popup__have-account\">\n                        Already have an account?  <a href=\"#\" class=\"header-registration-signup-popup__have-account-link\">Sign in <img class=\"header-registration-signup-popup__have-account-arrow\" src=\"/0b2fb4b4029557597325f4fd990e07be.svg\" alt=\"arrow\"></a>\n                    </p>\n                </form>\n            </div>\n        </div>\n        <!-- LINE -->\n        <div class=\"header-registration-singin-popup\">\n            <div class=\"header-registration-popup__img-block\">\n                <img class=\"header-registration-popup__img\" src=\"/619cd9e8006c090f72d5893795192792.jpg\" alt=\"Mascot\">\n            </div>\n            <div class=\"header-registration-popup__info-section\">\n                <div class=\"header-registration-popup__text-group\">\n                    <h1 class=\"header-registration-popup__title\">Welcome back!</h1>\n                </div>\n                <form class=\"header-registration-popup__form\"> \n                    <label class=\"header-registration-popup__label\" for=\"email-singin\">\n                        <input class=\"header-registration-popup__input\" type=\"email\" id=\"email-singin\" placeholder=\"Email\">\n                    </label>\n                    <label class=\"header-registration-popup__label\" for=\"password-singin\">\n                        <input class=\"header-registration-popup__input\" type=\"password\" id=\"password-singin\" placeholder=\"Password\">\n                    </label>\n                    <button class=\"header-registration-popup__submit\" id=\"submit-singin\" type=\"submit\">Sing In</button>\n                    <p class=\"header-registration-signin-popup__donothave-account\">\n                        Don't have an account? <a href=\"#\" class=\"header-registration-signin-popup__donothave-account-link\">Sign Up<img class=\"header-registration-signin-popup__donothave-account-arrow\" src=\"/0b2fb4b4029557597325f4fd990e07be.svg\" alt=\"arrow\"></a>\n                    </p>\n                </form>\n            </div>\n        </div>\n        <!-- POPUP -->\n    </header>\n    <main class=\"main\">\n        <div class=\"container main__content\">\n            <div class=\"hero\">\n                <div class=\"hero__info\">\n                    <h1 class=\"hero__title\">\n                        Learn languages <br> \n                            & <br>\n                        Remember forever\n                    </h1>\n                    <h2 class=\"hero__untertitle\">\n                        A platform that turns words into \n                        knowledge — powered by the science of \n                        memory\n                    </h2>\n                    <button type=\"button\" class=\"hero__start-button\">\n                        Start Now\n                        <img src=\"/9632b13b2c2758c19e95abb9160096d0.svg\" alt=\"icon\" class=\"hero__start-icon\">\n                    </button>\n                </div>\n                <img src=\"/033f67b55b6a265f04dd15bb1b7e489f.png\" alt=\"Imahe\" class=\"hero__image\">\n            </div>\n            <h1 class=\"quote\">\n                Less memorizing\n                More understanding\n            </h1>\n            <div class=\"features\" id=\"features-id\">\n                <h2 class=\"features__title\">Features</h2>\n                <ul class=\"features__item-box\">\n                    <li class=\"features__item\">\n                        <img src=\"/b4110a157bbef81f9da0a0ae2640aca2.png\" alt=\"Ebbinghaus\" class=\"features__item-img\">\n                        <h1 class=\"features__itme-text\">\n                            Based on the Ebbinghaus \n                            method\n                        </h1>\n                    </li>\n                    <li class=\"features__item\">\n                        <img src=\"/d34d406411d1f03f758d619093f7734c.png\" alt=\"One Place\" class=\"features__item-img\">\n                        <h1 class=\"features__itme-text\">\n                            All in one place\n                        </h1>\n                    </li>\n                    <li class=\"features__item\">\n                        <img src=\"/c514bd274e853287cd5038fdee24e619.png\" alt=\"Maskot\" class=\"features__item-img\">\n                        <h1 class=\"features__itme-text\">\n                            Made by a learner, for \n                            learners\n                        </h1>\n                    </li>\n                </ul>\n            </div>\n            <div class=\"how-it-works\" id=\"how-it-works-id\">\n                <h2 class=\"how-it-works__title\">How it works</h2>\n                <div class=\"how-it-works__content\">\n                    <div class=\"how-it-works__number-group\">\n                        <h3 class=\"how-it-works__number\">1</h3>\n                        <img src=\"/e6272b19fbfed7c40289d34b5cac3397.svg\" alt=\"line\" class=\"how-it-works__line\">\n                        <h3 class=\"how-it-works__number\">2</h3>\n                        <img src=\"/e6272b19fbfed7c40289d34b5cac3397.svg\" alt=\"line\" class=\"how-it-works__line\">\n                        <h3 class=\"how-it-works__number\">3</h3>\n                        <img src=\"/e6272b19fbfed7c40289d34b5cac3397.svg\" alt=\"line\" class=\"how-it-works__line\">\n                        <h3 class=\"how-it-works__number\">4</h3>\n                    </div>\n                    <div class=\"how-it-works__blocks-group\">\n                        <div class=\"how-it-works__block\">\n                            <h4 class=\"how-it-works__block-title\">Add</h4>\n                            <img src=\"/8cc8a2a098f5342e66b06234552c490f.svg\" alt=\"Add\" class=\"how-it-works__block-img\">\n                        </div>\n                        <div class=\"how-it-works__block\">\n                            <h4 class=\"how-it-works__block-title\">Learn</h4>\n                            <img src=\"/cf8e17b8b0d00c0c32f3f128b8e7ccab.svg\" alt=\"Learn\" class=\"how-it-works__block-img\">\n                        </div>\n                        <div class=\"how-it-works__block\">\n                            <h4 class=\"how-it-works__block-title\">Repeat</h4>\n                            <img src=\"/bb84eecab99273d5628b2407c17cdcef.svg\" alt=\"Repeat\" class=\"how-it-works__block-img\">\n                        </div>\n                        <div class=\"how-it-works__block\">\n                            <h4 class=\"how-it-works__block-title\">Remember</h4>\n                            <img src=\"/699416ba8efef7fadb0b2ae6e4915718.svg\" alt=\"Remember\" class=\"how-it-works__block-img\">\n                        </div>\n                    </div>\n                </div>\n                <img class=\"how-it-works__mascot\" src=\"/3b2eaaebb9001285e44ebbdcb037b82d.png\" alt=\"Mascot-hmm\">\n            </div>\n            <div class=\"vwa\" id=\"vwa-id\">\n                <h2 class=\"vwa__title\">VWA</h2>\n                <div class=\"vwa__content\">\n                    <div class=\"vwa__author-group\">\n                        <img src=\"/c236404fe719b9b292b72e631661d5a5.png\" alt=\"Author with mascot\" class=\"vwa__author-img\">\n                        <div class=\"vwa__author-info\">\n                            <h1 class=\"vwa__author-title\">Yehor Kantsyr</h1>\n                            <p class=\"vwa__author-subtitle\">(Creator of LingoIQ)</p>\n                        </div>\n                    </div>\n                    <p class=\"vwa__pharagrph\">\n                        Hi! I’m Yehor, and LingoIQ is my VWA project.\n                        <br>\n                        <br>\n                        I created this site to make language learning <b>simpler and more structured.</b> <br>\n                        Here, you can find words, grammar rules, and learning tools <b>all in one place.</b>\n                        <br>\n                        <br>\n                        The site includes a program I developed using <b>Hermann Ebbinghaus’ spaced repetition method</b> to help you remember words efficiently.\n                        It’s designed for students, migrants, and anyone eager to learn languages, offering <b>clear structures and easy navigation.</b>\n                        <br>\n                        <br>\n                        With LingoIQ, I want to give everyone the same opportunity I had: a clear path to mastering a new language.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </main>\n    <footer class=\"footer container\">\n        <a href=\"#\" class=\"footer-panel__logo-link\">\n            <img src=\"/c5c8c21b7