    parsePerlFlags(t) {
        const startPos = t.pos();
        const s = t.rest();
        if (s.startsWith("(?P<") || s.startsWith("(?<")) {
            const begin = s.charAt(2) === "P" ? 4 : 3;
            const end = s.indexOf(">");
