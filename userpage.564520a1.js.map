                    sawFlag = true;
                    break;
                case Codepoint.CODES.get("m"):
                    flags &= ~RE2Flags.ONE_LINE;
                    sawFlag = true;
                    break;
                case Codepoint.CODES.get("s"):
                    flags |= RE2Flags.DOT_NL;
                    sawFlag = true;
                    break;
                case Codepoint.CODES.get("U"):
                    flags |= RE2Flags.NON_GREEDY;
                    sawFlag = true;
                    break;
                case Codepoint.CODES.get("-"):
                    if (sign < 0) break loop;
                    sign = -1;
                    flags = ~flags;
                    sawFlag = false;
                    break;
                case Codepoint.CODES.get(":"):
                case Codepoint.CODES.get(")"):
