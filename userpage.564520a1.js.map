        c = t.pop();
        let name;
        if (c !== Codepoint.CODES.get("{")) name = Utils.runeToString(c);
        else {
            const rest = t.rest();
            const end = rest.indexOf("}");
            if (end < 0) {
                t.rewindTo(startPos);
                throw new RE2JSSyntaxException(Parser.ERR_INVALID_CHAR_RANGE, t.rest());
            }
            name = rest.substring(0, end);
            t.skipString(name);
            t.skip(1);
